{
  "name": "vcp-bench-adoption",
  "private": true,
  "version": "1.0.0",
  "description": "Van Cortlandt Park Bench Adoption Program — map-first civic inventory",
  "scripts": {
    "dev": "concurrently -n server,web -c green,cyan \"npm run server\" \"npm run web\"",
    "server": "node server/index.js",
    "web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "start": "NODE_ENV=production node server/index.js",
    "test:concurrency": "node server/concurrency-test.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "vite": "^6.3.5"
  }
}
